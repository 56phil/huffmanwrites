public/
resources/
.hugo_build.lock
.DS_Store
.sendfox_token
# Digest send copies. The draft is a working file, not source: it is written to
# pending/, sent through SendFox, and archived locally to pending/archive/. It was
# tracked until 2026-10-17, which meant every send owed a follow-up commit to
# remove it — a step that needed a catch-up commit five times (Sept 12 "three
# weeks late", Sept 19 "a day late", Sept 26, Oct 3, Oct 10). The template is the
# only source file in here.
pending/*.md
!pending/TEMPLATE.md
pending/archive/
.hermes/
.claude/launch.json
.serena/project.yml

# Python bytecode — regenerated on every run; local build artifact, not source
__pycache__/
*.pyc

# Docket-watch cursor — runtime state, rewritten twice daily by the launchd job.
# Local-only by design: on a fresh clone the watcher's first run records the
# newest entry without alerting on the whole filing history.
scripts/docket-watch-state.json

# Senate ratings baseline — last week's fetched ratings, written by
# scripts/fetch-senate-ratings.py --update-baseline and read by --changes.
# Local-only by design: on a fresh clone the first --update-baseline run
# establishes the baseline and --changes reports nothing until a forecaster
# actually moves a race.
scripts/senate-ratings-state.json
